# Bu dosyayı ".env" adıyla kopyalayıp kendi bilgilerinizi yazın. .env git'e eklenmez.

# --- Elektrik kesintileri: yedek kaynak EPİAŞ Şeffaflık Platformu. Ücretsiz hesap: https://giris.epias.com.tr
# Ana kaynak Gediz Elektrik'tir ve hesap gerektirmez. Bu bilgiler yalnızca Gediz'e ulaşılamadığında kullanılır.
EPIAS_USERNAME=
EPIAS_PASSWORD=

# --- Yayın (docker compose) ---
# Ortam: dev (varsayılan) ya da prod. prod'da /docs kapanır, genel rota sunucuları kullanılmaz.
# KP_ENV=prod
# Alan adı (Caddy https sertifikasını bunun için alır)
# DOMAIN=api.alanadiniz.com.tr

# --- İsteğe bağlı ---
# Kendi OSRM sunucularınız (docker compose bunları kendisi tanımlar)
# OSRM_URL=http://localhost:5000
# OSRM_FOOT_URL=http://localhost:5001
# IP'ye göre yaklaşık konum (kullanıcı IP'sini ipwho.is'e gönderir; gizlilik nedeniyle varsayılan kapalı)
# KP_IP_KONUM=0
# IP başına dakikadaki istek sınırı
# KP_RATE_LIMIT=120
# Expo anlık bildirim erişim anahtarı (Expo projesinde "enhanced push security" açıksa)
# EXPO_ACCESS_TOKEN=
